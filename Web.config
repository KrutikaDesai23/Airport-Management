<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="AirportDb" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=Airport Management;Integrated Security=True;MultipleActiveResultSets=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.5.2" />
    <httpRuntime targetFramework="4.5.2" />
    <pages controlRenderingCompatibilityVersion="4.0" />
  </system.web>
</configuration>
